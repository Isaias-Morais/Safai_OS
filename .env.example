# SafaiOS environment template. Copy to .env.local or your deployment secret store.
# Never commit real values. Browser-exposed variables may contain only publishable keys.

# Local development defaults supplied by `supabase start`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# Server-only: do not expose through NEXT_PUBLIC_* or any browser bundle.
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=

# Server-only AI/provider credentials. These are intentionally separate.
GEMINI_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Deployment environments must set their own URL and publishable key.
# Preview/staging: SUPABASE_URL= / SUPABASE_PUBLISHABLE_KEY=
# Production:      SUPABASE_URL= / SUPABASE_PUBLISHABLE_KEY=
